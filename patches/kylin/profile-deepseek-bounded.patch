+    def _chat_request_options(self) -> dict[str, object]:
+        # DeepSeek enables reasoning by default. A one-token gate can spend its
+        # entire budget on reasoning; unbounded JSON extraction can delay CLI
+        # shutdown for minutes. Keep extraction on the same model, explicitly
+        # use non-thinking structured output and bound this request.
+        if urlparse(str(getattr(self.client, "base_url", ""))).hostname == "api.deepseek.com":
+            return {"extra_body": {"thinking": {"type": "disabled"}},
+                    "max_tokens": 4096, "timeout": 15.0}
+        return {}
+
+    def _create_chat_completion(self, **kwargs):
+        if urlparse(str(getattr(self.client, "base_url", ""))).hostname != "api.deepseek.com":
+            return self.client.chat.completions.create(**kwargs)
+        from openai.types.chat import ChatCompletion
+
+        # DeepSeek sends whitespace while queued, so an idle read timeout does
+        # not bound the complete response. Read HTTP chunks (NOT model SSE),
+        # enforce elapsed time, and close the response before a native retry.
+        # A silent read is bounded separately by the 15-second SDK timeout.
+        started = time.monotonic()
+        deadline = started + 60.0
+        keepalives = 0
+        client = self.client.with_options(max_retries=0)
+        body = bytearray()
+        with client.chat.completions.with_streaming_response.create(**kwargs) as response:
+            for chunk in response.iter_bytes():
+                keepalives += int(not chunk.strip())
+                if time.monotonic() >= deadline:
+                    logging.getLogger(__name__).warning(
+                        "Profile HTTP response deadline reached: keepalive_chunks=%d", keepalives)
+                    raise TimeoutError("Profile request exceeded 60-second response deadline")
+                body.extend(chunk)
+            if time.monotonic() >= deadline:
+                raise TimeoutError("Profile request exceeded 60-second response deadline")
+        logging.getLogger(__name__).info(
+            "Profile HTTP response complete: elapsed=%.3fs keepalive_chunks=%d bytes=%d",
+            time.monotonic() - started, keepalives, len(body))
+        return ChatCompletion.model_validate_json(bytes(body))
+
